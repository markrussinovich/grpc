load("@rules_proto//proto:defs.bzl", "proto_library")
load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@com_github_grpc_grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")

proto_library(
    name = "echo_proto",
    srcs = ["echo.proto"],
    visibility = ["//visibility:public"],
)

cc_proto_library(
    name = "echo_cc_proto",
    deps = [":echo_proto"],
    visibility = ["//visibility:public"],
)

cc_grpc_library(
    name = "echo_cc_grpc",
    srcs = [":echo_proto"],
    grpc_only = True,
    deps = [":echo_cc_proto"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "shmem_server",
    srcs = ["shmem_server.cc"],
    deps = [
        ":echo_cc_proto",
        ":echo_cc_grpc",
        "//:grpc++",
        "//src/core/ext/transport/shmem:shmem_transport",
    ],
)

cc_binary(
    name = "shmem_client",
    srcs = ["shmem_client.cc"],
    deps = [
        ":echo_cc_proto",
        ":echo_cc_grpc",
        "//:grpc++",
        "//src/core/ext/transport/shmem:shmem_transport",
    ],
)
